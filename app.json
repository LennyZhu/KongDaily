{
  "expo": {
    "name": "KongDaily",
    "slug": "kongdaily",
    "version": "1.2.0",
    "platforms": [
      "ios"
    ],
    "scheme": "kongdaily",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lennystudio.kongdaily",
      "icon": "./assets/branding/app-icon-ios.png",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "CFBundleLocalizations": [
          "en",
          "zh-HK",
          "en",
          "zh-HK"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "locales": {
      "en": "./assets/locales/en.json",
      "zh-HK": "./assets/locales/zh-HK.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/branding/splash-logo.png",
            "imageWidth": 164,
            "backgroundColor": "#FAF9F5",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-HK"
            ]
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location helps KongDaily find nearby public transport stops and facilities and show their distance from you.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": "KongDaily's location library includes optional motion activity detection. KongDaily does not use your Motion & Fitness data."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "46b3f4a1-36a6-4a62-aebf-2a65b795e9fd"
      }
    },
    "owner": "homeypaw"
  }
}
