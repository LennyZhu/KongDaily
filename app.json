{
  "expo": {
    "name": "KongDaily",
    "slug": "kongdaily",
    "version": "1.0.0",
    "platforms": ["ios"],
    "scheme": "kongdaily",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lennystudio.kongdaily",
      "icon": "./assets/branding/app-icon-ios.png",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "locales": {
      "en": "./assets/locales/en.json",
      "zh-HK": "./assets/locales/zh-HK.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/branding/splash-logo.png",
            "imageWidth": 164,
            "backgroundColor": "#FAF9F5",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "zh-HK"]
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to find nearby facilities and bus stops and show their distance from your location.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false
        }
      ]
    ]
  }
}
