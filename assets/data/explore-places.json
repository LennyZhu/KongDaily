      "id": "victoria-peak-garden",
      "category": "pets",
      "additionalCategories": [
        "parks"
      ],
      "order": 80,
      "title": {
        "zh-HK": "山頂花園",
        "en": "Victoria Peak Garden"
      },
      "district": {
        "zh-HK": "中西區",
        "en": "Central and Western District"
      },
      "summary": {
        "zh-HK": "到柯士甸山道上方的園景和亭子走一趟，也可留意前總督山頂別墅的歷史痕跡。",
        "en": "Walk through the garden and pavilions above Mount Austin Road and look for traces of the former Governor’s summer residence."
      },
      "highlights": [
        {
          "zh-HK": "由柯士甸山道上行後，可沿園內蜿蜒小徑經過草地與亭子。",
          "en": "Follow winding paths past lawns and pavilions after walking up Mount Austin Road.",
          "sourceIds": [
            "hktb-tc",
            "hktb-en"
          ]
        },
        {
          "zh-HK": "前總督山頂別墅守衛室可作為閱讀園址歷史的路標。",
          "en": "The Gate Lodge is a landmark for understanding the site’s former use as a summer residence.",
          "sourceIds": [
            "amo-gatehouse-tc",
            "amo-gatehouse-en"
          ]
        }
      ],
      "transport": {
        "zh-HK": "到達山頂後，沿柯士甸山道上行前往花園。攜寵前請向交通營運商查詢攜寵條款。",
        "en": "From the Peak, walk uphill along Mount Austin Road to the garden. If travelling with a pet, check the transport operator’s policy first.",
        "sourceIds": [
          "hktb-tc",
          "hktb-en"
        ]
      },
      "cautions": {
        "zh-HK": "山頂花園屬寵物共享公園，狗隻在園內須繫上牽繩並受控制。請清理便溺物並遵循現場告示。",
        "en": "Victoria Peak Garden is an Inclusive Park for Pets. Keep dogs on a lead and under control throughout the garden, clean up after them and follow on-site signs.",
        "sourceIds": [
          "lcsd-pet-rules-tc",
          "lcsd-pet-rules-en",
          "lcsd-pet-list",
