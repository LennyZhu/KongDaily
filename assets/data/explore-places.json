    {
      "id": "west-kowloon-art-park",
      "category": "waterfront",
      "additionalCategories": [
        "pets"
      ],
      "order": 30,
      "title": {
        "zh-HK": "西九文化區藝術公園",
        "en": "Art Park (West Kowloon Cultural District)"
      },
      "district": {
        "zh-HK": "油尖旺區",
        "en": "Yau Tsim Mong District"
      },
      "summary": {
        "zh-HK": "沿西九藝術公園的海濱長廊散步，從草坪和觀景台一帶欣賞維港。",
        "en": "Walk the Art Park promenade and enjoy harbour views from the lawns and viewing terrace."
      },
      "highlights": [
        {
          "zh-HK": "從海濱長廊看向對岸，途中有海旁草坪。",
          "en": "Follow the promenade for cross-harbour views and lawns by the water.",
          "sourceIds": [
            "westk-guide-en"
          ]
        },
        {
          "zh-HK": "一樓觀景台提供較高的海濱視角。",
          "en": "The first-floor viewing terrace offers a higher vantage point over the waterfront.",
          "sourceIds": [
            "westk-guide-tc"
          ]
        },
        {
          "zh-HK": "近西閘設有雙閘的指定寵物區，可把海濱散步與該處停留安排在一起。",
          "en": "Pair a waterfront walk with a stop at the designated double-gated pet area near the West Gate.",
          "sourceIds": [
            "westk-guide-en"
          ]
        }
      ],
      "transport": {
        "zh-HK": "由港鐵九龍站參考管理局地圖，經圓方和藝術廣場天橋前往。",
        "en": "From MTR Kowloon Station, follow the district’s visitor map via Elements and Artist Square Bridge.",
        "sourceIds": [
          "westk-guide-tc",
          "westk-station-walk"
        ]
      },
      "cautions": {
        "zh-HK": "在適用的戶外公眾休憩用地，指定寵物區外須繫牽繩或使用合適容器。只可在指定寵物區內解繩。請清理寵物便溺物，並在出發前查閱場地安排及現場告示。",
        "en": "In the public outdoor areas covered by the rules, keep pets on a lead or in a suitable carrier outside the designated pet area. Off-lead access is limited to that area. Clean up after pets and check current access arrangements and posted signs.",
        "sourceIds": [
          "westk-rules",
          "westk-guide-en"
        ]
      },
      "sources": [
