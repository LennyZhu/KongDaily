      "title": {
        "zh-HK": "大埔海濱公園",
        "en": "Tai Po Waterfront Park"
      },
      "district": {
        "zh-HK": "大埔區",
        "en": "Tai Po District"
      },
      "summary": {
        "zh-HK": "沿着大埔海濱散步，從長廊和紀念塔一帶看吐露港。",
        "en": "Walk the Tai Po waterfront and take in Tolo Harbour from the promenade and lookout area."
      },
      "highlights": [
        {
          "zh-HK": "海濱長廊串連公園面向吐露港的一側。",
          "en": "The promenade follows the park’s Tolo Harbour frontage.",
          "sourceIds": [
            "lcsd-annual-tc"
          ]
        },
        {
          "zh-HK": "香港回歸紀念塔以螺旋形設計提供較高的觀景位置。",
          "en": "The Spiral Lookout Tower offers an elevated view over Tolo Harbour.",
          "sourceIds": [
            "lcsd-outdoors",
            "lcsd-annual-tc"
          ]
        }
      ],
      "transport": {
        "zh-HK": "按康文署的公共交通指引前往大埔大發街，再參考園圖選擇入口。",
        "en": "Follow LCSD’s public transport directions to Dai Fat Street in Tai Po, then use the park map to choose an entrance.",
        "sourceIds": [
          "lcsd-access-tc",
          "lcsd-access-en"
        ]
      },
      "cautions": {
