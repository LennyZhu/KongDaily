    {
      "id": "dragons-back-to-tei-wan-tai-tam-gap",
      "category": "hiking",
      "additionalCategories": [],
      "order": 10,
      "title": {
        "zh-HK": "龍脊",
        "en": "Dragon’s Back"
      },
      "district": {
        "zh-HK": "南區",
        "en": "Southern District"
      },
      "summary": {
        "zh-HK": "從土地灣踏上開揚山脊，經大潭灣和石澳方向的觀景位置，最後走往大潭峽。",
        "en": "Follow the ridge from To Tei Wan, with views towards Tai Tam Bay and Shek O before finishing at Tai Tam Gap."
      },
      "highlights": [
        {
          "zh-HK": "初段觀景點可看大潭灣與大潭港。",
          "en": "The early lookout faces Tai Tam Bay and Tai Tam Harbour.",
          "sourceIds": [
            "afcd-route"
          ]
        },
        {
          "zh-HK": "打爛埕頂山可俯看石澳灣一帶。",
          "en": "Look over the coast by Shek O from Shek O Peak.",
          "sourceIds": [
            "afcd-peak",
            "afcd-map"
          ]
        }
      ],
      "transport": {
        "zh-HK": "乘城巴 9 號到石澳道土地灣站，下車後循港島徑標示步行往起點。走到大潭峽後，可前往歌連臣角站轉乘巴士。",
        "en": "Take Citybus 9 to To Tei Wan on Shek O Road and follow signs for the Hong Kong Trail. On the Tai Tam Gap side, the route connects to the Cape Collinson bus stop.",
        "sourceIds": [
          "afcd-route",
          "afcd-map"
        ]
      },
      "cautions": {
        "zh-HK": "按漁護署地圖確認大潭峽走法，出發前查看山徑公告、天氣和巴士安排。",
        "en": "Check the AFCD map for the Tai Tam Gap itinerary and review trail notices, weather and bus service before setting out.",
        "sourceIds": [
          "afcd-notices",
          "afcd-map"
        ]
      },
