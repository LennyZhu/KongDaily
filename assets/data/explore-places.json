    {
      "id": "avenue-of-stars",
      "category": "waterfront",
      "additionalCategories": [],
      "order": 40,
      "title": {
        "zh-HK": "星光大道",
        "en": "Avenue of Stars"
      },
      "district": {
        "zh-HK": "油尖旺區",
        "en": "Yau Tsim Mong District"
      },
      "summary": {
        "zh-HK": "沿維港散步，從影人掌印和雕塑認識香港電影。",
        "en": "Walk beside Victoria Harbour and explore Hong Kong cinema through its handprints and sculptures."
      },
      "highlights": [
        {
          "zh-HK": "沿木欄找不同香港影人的掌印。",
          "en": "Look for handprints of Hong Kong film figures along the railings.",
          "sourceIds": [
            "hktb-walk-tc"
          ]
        },
        {
          "zh-HK": "李小龍雕像是電影主題段的具體停留點。",
          "en": "Pause at the Bruce Lee statue, one of the film-themed stops on the promenade.",
          "sourceIds": [
            "hktb-walk-en"
          ]
        }
      ],
      "transport": {
        "zh-HK": "可乘天星小輪抵尖沙咀碼頭，再沿海濱步行往星光大道。",
        "en": "Arrive by Star Ferry at Tsim Sha Tsui Pier and follow the waterfront to the Avenue of Stars.",
        "sourceIds": [
          "hktb-ferry-tc",
          "hktb-walk-en"
        ]
      },
      "cautions": {
        "zh-HK": "海濱步行範圍大，沿現場標示找電影主題段。乘船前查看碼頭安排。",
        "en": "The waterfront covers a wide area. Follow signs to the film-themed section and check pier arrangements before taking the ferry.",
