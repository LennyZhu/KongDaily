    {
      "id": "peak-circle-walk",
      "category": "hiking",
      "additionalCategories": [],
      "order": 20,
      "title": {
        "zh-HK": "山頂環迴步行徑",
        "en": "Peak Circle Walk"
      },
      "district": {
        "zh-HK": "中西區",
        "en": "Central and Western District"
      },
      "summary": {
        "zh-HK": "走盧吉道和夏力道繞山頂一圈，途中可看維港和林蔭。",
        "en": "Circle the Peak via Lugard Road and Harlech Road, combining harbour views with shaded stretches."
      },
      "highlights": [
        {
          "zh-HK": "盧吉道向維港一側可眺望港島和九龍。",
          "en": "The harbour-facing stretch of Lugard Road looks across to urban Hong Kong Island and Kowloon.",
          "sourceIds": [
            "hktb-tc",
            "hktb-family-hikes"
          ]
        },
        {
          "zh-HK": "沿盧吉道可從路上欣賞 1 號及 27 號等早期香港住宅的外觀。",
          "en": "Look for early Hong Kong residences along Lugard Road, including Nos. 1 and 27, from the road.",
          "sourceIds": [
            "hktb-en"
          ]
        }
      ],
      "transport": {
        "zh-HK": "由花園道乘山頂纜車至凌霄閣，或按旅發局指引乘巴士到山頂廣場，再循盧吉道指示。",
        "en": "Take the Peak Tram from Garden Road, or consult HKTB’s bus directions to Peak Galleria and follow signs for Lugard Road.",
        "sourceIds": [
          "hktb-tc",
          "hktb-en"
        ]
      },
      "cautions": {
        "zh-HK": "運輸安排可能有變，出發前重查旅發局交通及現場告示。",
        "en": "Check the visitor transport guide and on-site notices before walking the circuit.",
        "sourceIds": [
          "hktb-en"
        ]
      },
      "sources": [
