    {
      "id": "hong-kong-park",
      "category": "parks",
      "additionalCategories": [],
      "order": 50,
      "title": {
        "zh-HK": "香港公園",
        "en": "Hong Kong Park"
      },
      "district": {
        "zh-HK": "中西區",
        "en": "Central and Western District"
      },
      "summary": {
        "zh-HK": "從人工湖和瀑布走到舊軍營文物建築，看看一座市區公園如何利用原有地形。",
        "en": "Explore a city park shaped around an artificial lake, a waterfall and buildings from the former garrison."
      },
      "highlights": [
        {
          "zh-HK": "人工湖與瀑布位於昔日軍營網球場一帶。",
          "en": "The park’s lake and waterfall occupy the site of a former garrison tennis court.",
          "sourceIds": [
            "lcsd-visit-tc"
          ]
        },
        {
          "zh-HK": "園內的旗杆屋保留了維多利亞軍營時期的建築。",
          "en": "Flagstaff House preserves part of the site’s garrison-era architecture.",
          "sourceIds": [
            "lcsd-visit-en"
          ]
        },
        {
          "zh-HK": "尤德觀鳥園借用了山坡旁的天然山谷地形。",
          "en": "The Edward Youde Aviary is set in a natural valley on the hillside.",
          "sourceIds": [
            "lcsd-aviary-tc",
            "lcsd-aviary-en"
          ]
        }
      ],
      "transport": {
        "zh-HK": "由港鐵金鐘站或中環站按公園官網的出口及交通指引步行前往。",
        "en": "Use the park’s official visitor directions from MTR Admiralty or Central.",
        "sourceIds": [
          "lcsd-visit-tc",
          "lcsd-visit-en"
        ]
      },
      "cautions": {
        "zh-HK": "公園與觀鳥園等設施有各自安排，惡劣天氣可暫停開放。請查當天官網。",
        "en": "Visitor arrangements vary by facility, and severe weather may cause closures. Check the park website on the day.",
        "sourceIds": [
          "lcsd-visit-tc"
        ]
      },
      "sources": [
